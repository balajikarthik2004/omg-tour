# ---- Data source -------------------------------------------------------
# true  -> the table renders the placeholder rows in src/mockData.ts
# false -> the table calls GET /admin/usa-tour-requests for real
VITE_USE_MOCK_DATA=true

# Base URL of the API that serves GET /admin/usa-tour-requests.
# Used by the Vite dev server proxy (see vite.config.ts).
VITE_API_BASE_URL=http://localhost:3000

# Optional: sent as "Authorization: Bearer <token>" if the admin route is protected.
# VITE_API_TOKEN=
